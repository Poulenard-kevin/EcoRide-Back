{% extends 'base.html.twig' %}

{% block title %}Mon tableau de bord{% endblock %}

{% block body %}
    <h1 class="mb-4">Bienvenue, {{ app.user.firstName }} 👋</h1>

    <div class="row">
        {# 🔹 Bloc : Réservations #}
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0"><i class="bi bi-calendar-check"></i> Mes prochaines réservations</h5>
                </div>
                <div class="card-body">
                    {% if myBookings is not empty %}
                        <ul class="list-group list-group-flush">
                            {% for booking in myBookings %}
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div>
                                        Réservation n°{{ booking.id }} pour 
                                        <a href="{{ path('app_carpool_show', {'id': booking.carpool.id}) }}">
                                            {{ booking.carpool.departureLocation }} → {{ booking.carpool.arrivalLocation }}
                                        </a>
                                        le {{ booking.carpool.departureDate|date('d/m/Y') }}
                                    </div>
                                    <div class="d-flex flex-column align-items-end">
                                        <span class="badge bg-info text-dark mb-1">{{ booking.reservedSeats }} place(s)</span>
                                        
                                        {# Badge de statut #}
                                        {% if booking.status == 'pending' %}
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-clock"></i> En attente
                                            </span>
                                        {% elseif booking.status == 'confirmed' %}
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Confirmée
                                            </span>
                                        {% elseif booking.status == 'refused' %}
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle"></i> Refusée
                                            </span>
                                        {% elseif booking.status == 'cancelled' %}
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-slash-circle"></i> Annulée
                                            </span>
                                        {% endif %}
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                        <div class="text-end mt-3">
                            <a href="{{ path('app_booking_index') }}" class="btn btn-sm btn-outline-primary">Voir toutes mes réservations</a>
                        </div>
                    {% else %}
                        <p>Vous n'avez pas de réservations à venir.</p>
                        <a href="{{ path('app_carpool_index') }}" class="btn btn-primary">Rechercher un covoiturage</a>
                    {% endif %}
                </div>
            </div>
        </div>

        {# 🔹 Bloc : Covoiturages #}
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0"><i class="bi bi-car-front-fill"></i> Mes covoiturages proposés</h5>
                </div>
                <div class="card-body">
                    {% if myCarpools is not empty %}
                        <ul class="list-group list-group-flush">
                            {% for carpool in myCarpools %}
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div>
                                        <a href="{{ path('app_carpool_show', {'id': carpool.id}) }}">
                                            {{ carpool.departureLocation }} → {{ carpool.arrivalLocation }}
                                        </a> le {{ carpool.departureDate|date('d/m/Y') }}
                                    </div>
                                    <div class="d-flex flex-column align-items-end">
                                        <span class="badge bg-success mb-1">{{ carpool.availableSeats }} place(s) dispo</span>
                                        
                                        {# Badge de statut du covoiturage avec couleur dynamique #}
                                        <span class="badge 
                                            {% if carpool.status == STATUS_ACTIVE %}bg-success
                                            {% elseif carpool.status == STATUS_COMPLETED %}bg-info text-dark
                                            {% elseif carpool.status == STATUS_CANCELLED %}bg-danger
                                            {% elseif carpool.status == STATUS_ARCHIVED %}bg-secondary
                                            {% else %}bg-light text-dark
                                            {% endif %}
                                        ">
                                            {% if carpool.status == STATUS_ACTIVE %}
                                                <i class="bi bi-play-circle"></i>
                                            {% elseif carpool.status == STATUS_COMPLETED %}
                                                <i class="bi bi-flag-checkered"></i>
                                            {% elseif carpool.status == STATUS_CANCELLED %}
                                                <i class="bi bi-x-circle"></i>
                                            {% elseif carpool.status == STATUS_ARCHIVED %}
                                                <i class="bi bi-archive"></i>
                                            {% else %}
                                                <i class="bi bi-question-circle"></i>
                                            {% endif %}
                                            {{ carpool.statusLabel }}
                                        </span>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                        <div class="text-end mt-3">
                            <a href="{{ path('app_carpool_index') }}" class="btn btn-sm btn-outline-primary">Voir tous mes covoiturages</a>
                        </div>
                    {% else %}
                        <p>Vous n'avez pas encore proposé de covoiturage.</p>
                        <a href="{{ path('app_carpool_new') }}" class="btn btn-primary">Proposer un covoiturage</a>
                    {% endif %}
                </div>
            </div>
        </div>

    {# ✅ Bloc : Véhicules #}
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="card-title mb-0"><i class="bi bi-car-front"></i> Mes véhicules</h5>
                </div>
                <div class="card-body">
                    {% if myCars is not empty %}
                        <ul class="list-group list-group-flush">
                            {% for car in myCars %}
                                <li class="list-group-item">
                                    <a href="{{ path('app_car_show', {'id': car.id}) }}">
                                        {{ car.brand }} {{ car.model }}
                                    </a>
                                    <span class="text-muted ms-2">({{ car.registration }})</span>
                                    <span class="badge bg-secondary float-end">{{ car.seats }} places</span>
                                </li>
                            {% endfor %}
                        </ul>
                        <div class="text-end mt-3">
                            <a href="{{ path('app_car_index') }}" class="btn btn-sm btn-outline-primary">Voir tous mes véhicules</a>
                        </div>
                    {% else %}
                        <p>Vous n'avez pas encore enregistré de véhicule.</p>
                        <a href="{{ path('app_car_new') }}" class="btn btn-primary">Ajouter un véhicule</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# 🔜 Bloc "Mes avis" (future section à venir) #}
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm text-center p-4">
                <h5 class="text-muted">
                    <i class="bi bi-chat-quote"></i> Bientôt disponible : vos avis laissés et reçus 🌟
                </h5>
            </div>
        </div>
    </div>
{% endblock %}