<form method="post" action="{{ path('app_car_delete', {'id': car.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette voiture ?');" style="display:inline-block;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ car.id) }}">
    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
</form>