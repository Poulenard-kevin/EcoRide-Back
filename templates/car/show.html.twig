{% extends 'base.html.twig' %}

{% block title %}Détails de la voiture{% endblock %}

{% block body %}
    <h1 class="mb-4">Détails de la voiture</h1>

   <div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title">{{ car.brand }} {{ car.model }}</h5>
        <h6 class="card-subtitle mb-3 text-muted">Immatriculation : {{ car.registration }}</h6>

        <table class="table table-bordered table-striped">
            <tbody>
                <tr>
                    <th>Couleur</th>
                    <td>{{ car.color }}</td>
                </tr>
                <tr>
                    <th>Type d'énergie</th>
                    <td>{{ car.fuelType }}</td>
                </tr>
                <tr>
                    <th>Nombre de places</th>
                    <td>{{ car.seats }}</td>
                </tr>
                <tr>
                    <th>Préférences chauffeur</th>
                    <td>
                        {% if car.driverPreferences is not empty %}
                            {{ car.driverPreferences|join(', ') }}
                        {% else %}
                            <span class="text-muted fst-italic">Aucune</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Autres préférences</th>
                    <td>
                        {% if car.otherPreferences is not empty %}
                            {{ car.otherPreferences|join(', ') }}
                        {% else %}
                            <span class="text-muted fst-italic">Aucune</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                <th>Propriétaire</th>
                <td>
                    {% if car.owner %}
                        <a href="{{ path('app_user_show', {'id': car.owner.id}) }}">
                            {{ car.owner.firstName }} {{ car.owner.lastName }}
                        </a>
                    {% else %}
                        Aucun propriétaire
                    {% endif %}
                </td>
            </tr>
            </tbody>
        </table>

        <a href="{{ path('app_car_index') }}" class="btn btn-secondary me-2">Retour à la liste</a>
        <a href="{{ path('app_car_edit', {'id': car.id}) }}" class="btn btn-warning me-2">Modifier</a>
        {{ include('car/_delete_form.html.twig') }}
    </div>
</div>

    <h2 class="mt-5">Covoiturages utilisant ce véhicule</h2>

    {% if car.carpools|length > 0 %}
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Départ</th>
                        <th>Arrivée</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for carpool in car.carpools %}
                        <tr>
                            <td>{{ carpool.departureLocation }}</td>
                            <td>{{ carpool.arrivalLocation }}</td>
                            <td>{{ carpool.departureDate ? carpool.departureDate|date('d/m/Y') : 'N/A' }}</td>
                            <td>
                                <a href="{{ path('app_carpool_show', {'id': carpool.id}) }}" class="btn btn-sm btn-primary" title="Voir">
                                    <i class="bi bi-eye"></i> Voir
                                </a>
                                <a href="{{ path('app_carpool_edit', {'id': carpool.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                    <i class="bi bi-pencil"></i> Modifier
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p>Aucun covoiturage associé à ce véhicule.</p>
    {% endif %}
{% endblock %}