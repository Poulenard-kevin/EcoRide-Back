{% extends 'base.html.twig' %}
{% block title %}Mes avis reçus{% endblock %}
{% block body %}
<div class="container py-4">
    <h1 class="h4 mb-3">Avis reçus</h1>

    {% if reviews is empty %}
        <div class="alert alert-info">Aucun avis reçu pour le moment.</div>
    {% else %}
        {% for r in reviews %}
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <strong>{{ r.author ? (r.author.firstName ~ ' ' ~ r.author.lastName)|trim : 'Anonyme' }}</strong>
                        <span class="text-warning">
                            {% for i in 1..5 %}
                                {% if i <= r.rating %}<i class="bi bi-star-fill"></i>{% else %}<i class="bi bi-star"></i>{% endif %}
                            {% endfor %}
                        </span>
                    </div>
                    <p class="small text-muted mb-2">{{ r.date ? r.date|date('d/m/Y H:i') : '' }}</p>
                    <p class="mb-0">{{ r.comment|e }}</p>
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>
{% endblock %}