{% extends 'base.html.twig' %}
{% block title %}Mes avis{% endblock %}
{% block body %}
<div class="container py-4">
    <h1 class="h4 mb-3">Mes avis</h1>

    {% if reviews is empty %}
        <div class="alert alert-info">Vous n'avez encore laissé aucun avis.</div>
    {% else %}
        {% for r in reviews %}
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div><strong>Pour : {{ r.target ? (r.target.firstName ~ ' ' ~ r.target.lastName)|trim : '—' }}</strong></div>
                        <span class="text-warning">
                            {% for i in 1..5 %}
                                {% if i <= r.rating %}<i class="bi bi-star-fill"></i>{% else %}<i class="bi bi-star"></i>{% endif %}
                            {% endfor %}
                        </span>
                    </div>

                    <p class="small text-muted mb-2">{{ r.date ? r.date|date('d/m/Y H:i') : '' }}</p>
                    <p class="mb-2">{{ r.comment|e }}</p>

                    <div class="d-flex gap-2">
                        <a href="{{ path('review_edit', {id: r.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>

                        <form method="post" action="{{ path('review_delete_front', {id: r.id}) }}" onsubmit="return confirm('Supprimer cet avis ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ r.id) }}">
                            <button class="btn btn-sm btn-outline-danger">Supprimer</button>
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>
{% endblock %}