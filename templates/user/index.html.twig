{% extends 'base.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block body %}
    <h1 class="mb-4">Liste des utilisateurs</h1>

    <a href="{{ path('app_user_new') }}" class="btn btn-primary mb-3">Créer un nouvel utilisateur</a>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Mot de passe</th>
                <th>Rôle</th>
                <th>Note moyenne</th>
                <th>À propos</th>
                <th>Dernière réinitialisation</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.lastName }}</td>
                <td>{{ user.firstName }}</td>
                <td>{{ user.email }}</td>
                <td class="text-truncate" style="max-width: 150px;">Hash sécurisé</td>
                <td>{{ user.role }}</td>
                <td>{{ user.averageRating }}</td>
                <td>{{ user.about }}</td>
                <td>{{ user.lastPasswordResetRequestAt ? user.lastPasswordResetRequestAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                <div class="d-flex justify-content-center align-items-center gap-2">
                    <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-primary btn-sm" title="Voir">
                    <i class="bi bi-eye"></i> Voir
                    </a>
                    <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-warning btn-sm" title="Modifier">
                    <i class="bi bi-pencil"></i> Modifier
                    </a>
                    <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cet utilisateur ?');" style="margin: 0;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                    <button class="btn btn-danger btn-sm" title="Supprimer" type="submit">
                        <i class="bi bi-trash"></i> Supprimer
                    </button>
                    </form>
                </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10" class="text-center">Aucun utilisateur trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}