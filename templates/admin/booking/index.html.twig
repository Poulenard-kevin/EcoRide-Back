{% extends 'base.html.twig' %}

{% block title %}Liste des réservations{% endblock %}

{% block body %}
    <h1 class="mb-4">Liste des réservations</h1>

    <a href="{{ path('app_booking_new') }}" class="btn btn-primary mb-3">Créer une nouvelle réservation</a>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">ID</th>
                    <th>Passager</th>
                    <th scope="col">Date de réservation</th>
                    <th scope="col">Nombre de places</th>
                    <th scope="col">Statut</th>
                    <th scope="col">Covoiturage</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for booking in bookings %}
                    <tr>
                        <td>{{ booking.id }}</td>
                        <td>
                           {% if booking.passenger %}
                                <a href="{{ path('app_user_show', {'id': booking.passenger.id}) }}">
                                    {{ booking.passenger.firstName }} {{ booking.passenger.lastName }}
                                </a>
                            {% else %}
                                <span class="text-muted fst-italic">Inconnu</span>
                            {% endif %}
                        </td>
                        <td>{{ booking.bookingDate ? booking.bookingDate|date('d/m/Y H:i') : '' }}</td>
                        <td>{{ booking.reservedSeats }}</td>
                        <td>
                            {% set status = booking.status %}
                            {% if status == constant('App\\Entity\\Booking::STATUS_CONFIRMED') %}
                                <span class="badge bg-success">Confirmée</span>
                            {% elseif status == constant('App\\Entity\\Booking::STATUS_CANCELLED') %}
                                <span class="badge bg-danger">Annulée</span>
                            {% elseif status == constant('App\\Entity\\Booking::STATUS_PENDING') %}
                                <span class="badge bg-warning text-dark">En attente</span>
                            {% else %}
                                <span class="badge bg-secondary">Inconnu</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if booking.carpool %}
                                <a href="{{ path('app_carpool_show', {'id': booking.carpool.id}) }}">
                                    {{ booking.carpool.departureLocation }} → {{ booking.carpool.arrivalLocation }}
                                    ({{ booking.carpool.departureDate ? booking.carpool.departureDate|date('d/m/Y') : 'N/A' }})
                                </a>
                            {% else %}
                                <span class="text-muted fst-italic">Aucun covoiturage</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="d-flex justify-content-center align-items-center gap-2">
                                <a href="{{ path('app_booking_show', {'id': booking.id}) }}" class="btn btn-sm btn-primary" title="Voir">
                                    <i class="bi bi-eye"></i> Voir
                                </a>
                                <a href="{{ path('app_booking_edit', {'id': booking.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                    <i class="bi bi-pencil"></i> Modifier
                                </a>
                                <form method="post" action="{{ path('app_booking_delete', {'id': booking.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette réservation ?');" style="display:inline-block;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ booking.id) }}">
                                    <button class="btn btn-sm btn-danger" title="Supprimer" type="submit">
                                        <i class="bi bi-trash"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center fst-italic">Aucune réservation trouvée</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}