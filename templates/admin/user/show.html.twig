{% extends 'base.html.twig' %}

{% block title %}Détails de l'utilisateur{% endblock %}

{% block body %}
    <h1 class="mb-4">Détails de l'utilisateur</h1>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr><th>Id</th><td>{{ user.id }}</td></tr>
                    <tr><th>Nom</th><td>{{ user.lastName }}</td></tr>
                    <tr><th>Prénom</th><td>{{ user.firstName }}</td></tr>
                    <tr><th>Email</th><td>{{ user.email }}</td></tr>
                    <tr><th>Mot de passe</th><td>••••••••</td></tr>
                    <tr><th>Rôle</th><td>{{ user.role }}</td></tr>
                    <tr><th>Note moyenne</th><td>{{ user.averageRating }}</td></tr>
                    <tr><th>À propos</th><td>{{ user.about }}</td></tr>
                    <tr><th>Dernière réinitialisation</th><td>{{ user.lastPasswordResetRequestAt ? user.lastPasswordResetRequestAt|date('Y-m-d H:i:s') : '' }}</td></tr>
                </tbody>
            </table>

            <div class="mt-3 d-flex gap-2">
                <a href="{{ path('app_user_index') }}" class="btn btn-secondary">Retour à la liste</a>
                <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-warning">Modifier</a>
                {{ include('user/_delete_form.html.twig') }}
            </div>
        </div>
    </div>

    <h2 class="mt-5">Véhicules possédés</h2>

    {% if user.cars|length > 0 %}
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Marque</th>
                        <th>Modèle</th>
                        <th>Immatriculation</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for car in user.cars %}
                        <tr>
                            <td>{{ car.brand }}</td>
                            <td>{{ car.model }}</td>
                            <td>{{ car.registration }}</td>
                            <td>
                                <a href="{{ path('app_car_show', {'id': car.id}) }}" class="btn btn-sm btn-primary">Voir</a>
                                <a href="{{ path('app_car_edit', {'id': car.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p>Aucun véhicule associé.</p>
    {% endif %}

    <h2 class="mt-5">Covoiturages proposés</h2>

    {% if user.carpools|length > 0 %}
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Départ</th>
                        <th>Arrivée</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for carpool in user.carpools %}
                        <tr>
                            <td>{{ carpool.departureLocation }}</td>
                            <td>{{ carpool.arrivalLocation }}</td>
                            <td>{{ carpool.departureDate ? carpool.departureDate|date('d/m/Y') : 'N/A' }}</td>
                            <td>
                                <a href="{{ path('app_carpool_show', {'id': carpool.id}) }}" class="btn btn-sm btn-primary">Voir</a>
                                <a href="{{ path('app_carpool_edit', {'id': carpool.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p>Aucun covoiturage proposé.</p>
    {% endif %}
{% endblock %}