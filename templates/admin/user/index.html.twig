{% extends 'base.html.twig' %}

{% block title %}Liste des utilisateurs (Admin){% endblock %}

{% block body %}
<h1>Liste des utilisateurs (Admin)</h1>

<a href="{{ path('admin_user_new') }}" class="btn btn-primary mb-3">Créer un nouvel utilisateur</a>

<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.lastName }}</td>
                    <td>{{ user.firstName }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ user.role }}</td>
                    <td>
                        <div class="d-flex justify-content-center align-items-center gap-2">
                            <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="btn btn-sm btn-primary" title="Voir">
                                <i class="bi bi-eye"></i> Voir
                            </a>
                            <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                <i class="bi bi-pencil"></i> Modifier
                            </a>
                            <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer ce covoiturage ?');" style="margin: 0;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                <button class="btn btn-sm btn-danger" title="Supprimer" type="submit">
                                    <i class="bi bi-trash"></i> Supprimer
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">Aucun utilisateur trouvé.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}