{% extends 'base.html.twig' %}

{% block title %}Liste des voitures{% endblock %}

{% block body %}
    <h1 class="mb-4">Liste des voitures</h1>

    <a href="{{ path('app_car_new') }}" class="btn btn-primary mb-3">Créer une nouvelle voiture</a>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Marque</th>
                    <th scope="col">Modèle</th>
                    <th scope="col">Couleur</th>
                    <th scope="col">Type d’énergie</th>
                    <th scope="col">Immatriculation</th>
                    <th scope="col">Places</th>
                    <th scope="col">Préférences chauffeur</th>
                    <th scope="col">Autres préférences</th>
                    <th scope="col">Propriétaire</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for car in cars %}
                    <tr>
                        <td>{{ car.id }}</td>
                        <td>{{ car.brand }}</td>
                        <td style="white-space: nowrap;">{{ car.model }}</td>
                        <td>{{ car.color }}</td>
                        <td>{{ car.fuelType }}</td>
                        <td>{{ car.registration }}</td>
                        <td>{{ car.seats }}</td>
                        <td style="white-space: nowrap;">
                            {% if car.driverPreferences is not empty %}
                                {{ car.driverPreferences|join(', ') }}
                            {% else %}
                                <span class="text-muted fst-italic">Aucune</span>
                            {% endif %}
                        </td>
                        <td title="{{ car.otherPreferences }}">
                            {% if car.otherPreferences %}
                                {{ car.otherPreferences|length > 15 ? car.otherPreferences|slice(0, 15) ~ '...' : car.otherPreferences }}
                            {% else %}
                                <span class="text-muted fst-italic">Aucune</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if car.owner %}
                                <a href="{{ path('app_user_show', {'id': car.owner.id}) }}">
                                    {{ car.owner.firstName }} {{ car.owner.lastName }}
                                </a>
                            {% else %}
                                Aucun propriétaire
                            {% endif %}
                        </td>
                        <td>
                        <div class="d-flex justify-content-center align-items-center gap-2">
                            <a href="{{ path('app_car_show', {'id': car.id}) }}" class="btn btn-sm btn-primary" title="Voir">
                            <i class="bi bi-eye"></i> Voir
                            </a>
                            <a href="{{ path('app_car_edit', {'id': car.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                            <i class="bi bi-pencil"></i> Modifier
                            </a>
                            <form method="post" action="{{ path('app_car_delete', {'id': car.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette voiture ?');" style="margin: 0;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ car.id) }}">
                            <button class="btn btn-sm btn-danger" title="Supprimer" type="submit">
                                <i class="bi bi-trash"></i> Supprimer
                            </button>
                            </form>
                        </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="11" class="text-center fst-italic">Aucune voiture trouvée</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}