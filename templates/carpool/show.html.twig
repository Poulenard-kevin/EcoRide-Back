{% extends 'base.html.twig' %}

{% block title %}Détail du covoiturage{% endblock %}

{% block body %}
    <h1 class="mb-4">Détail du covoiturage</h1>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr><th>Id</th><td>{{ carpool.id }}</td></tr>
                    <tr><th>Date départ</th><td>{{ carpool.departureDate ? carpool.departureDate|date('d/m/Y') : '' }}</td></tr>
                    <tr><th>Heure départ</th><td>{{ carpool.departureTime ? carpool.departureTime|date('H:i') : '' }}</td></tr>
                    <tr><th>Lieu départ</th><td>{{ carpool.departureLocation }}</td></tr>
                    <tr><th>Date arrivée</th><td>{{ carpool.arrivalDate ? carpool.arrivalDate|date('d/m/Y') : '' }}</td></tr>
                    <tr><th>Heure arrivée</th><td>{{ carpool.arrivalTime ? carpool.arrivalTime|date('H:i') : '' }}</td></tr>
                    <tr><th>Lieu arrivée</th><td>{{ carpool.arrivalLocation }}</td></tr>
                    <tr><th>Prix par place</th><td>{{ carpool.pricePerSeat }} crédits</td></tr>
                    <tr><th>Places disponibles</th><td>{{ carpool.availableSeats }}</td></tr>
                    <tr><th>Nombre total de places</th><td>{{ carpool.totalSeats }}</td></tr>
                    <tr>
                        <th>Statut</th>
                        <td>
                            {% set status = carpool.status %}
                            {% if status == constant('App\\Entity\\Carpool::STATUS_ACTIVE') %}
                                <span class="badge bg-success">Actif</span>
                            {% elseif status == constant('App\\Entity\\Carpool::STATUS_COMPLETED') %}
                                <span class="badge bg-primary">Terminé</span>
                            {% elseif status == constant('App\\Entity\\Carpool::STATUS_CANCELLED') %}
                                <span class="badge bg-danger">Annulé</span>
                            {% elseif status == constant('App\\Entity\\Carpool::STATUS_ARCHIVED') %}
                                <span class="badge bg-secondary">Archivé</span>
                            {% else %}
                                <span class="badge bg-light text-dark">Inconnu</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Chauffeur</th>
                        <td>
                            {% if carpool.driver %}
                                <a href="{{ path('app_user_show', {'id': carpool.driver.id}) }}">
                                    {{ carpool.driver.firstName }} {{ carpool.driver.lastName }}
                                </a>
                            {% else %}
                                N/A
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Voiture</th>
                        <td>
                            {% if carpool.car %}
                                <a href="{{ path('app_car_show', {'id': carpool.car.id}) }}">
                                    {{ carpool.car.brand }} {{ carpool.car.model }} ({{ carpool.car.registration }})
                                </a>
                            {% else %}
                                N/A
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="mt-3 d-flex gap-2">
                <a href="{{ path('app_carpool_index') }}" class="btn btn-secondary">Retour à la liste</a>
                
                {# ✅ Seul le conducteur peut modifier/supprimer #}
                {% if app.user == carpool.driver %}
                    <a href="{{ path('app_carpool_edit', {'id': carpool.id}) }}" class="btn btn-warning">Modifier</a>
                    {{ include('carpool/_delete_form.html.twig') }}
                {% endif %}
            </div>
        </div>
    </div>

    <h2 class="mt-5">Réservations pour ce covoiturage</h2>

    {% if carpool.bookings|length > 0 %}
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Passager</th>
                        <th>Date de réservation</th>
                        <th>Nombre de places</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for booking in carpool.bookings %}
                        <tr>
                            <td>
                                {% if booking.passenger %}
                                    <a href="{{ path('app_user_show', {'id': booking.passenger.id}) }}">
                                        {{ booking.passenger.firstName }} {{ booking.passenger.lastName }}
                                    </a>
                                {% else %}
                                    <span class="text-muted fst-italic">Inconnu</span>
                                {% endif %}
                            </td>
                            <td>{{ booking.bookingDate ? booking.bookingDate|date('d/m/Y H:i') : 'N/A' }}</td>
                            <td>{{ booking.reservedSeats }}</td>
                            <td>
                                {% set status = booking.status %}
                                {% if status == constant('App\\Entity\\Booking::STATUS_CONFIRMED') %}
                                    <span class="badge bg-success">Confirmée</span>
                                {% elseif status == constant('App\\Entity\\Booking::STATUS_CANCELLED') %}
                                    <span class="badge bg-danger">Annulée</span>
                                {% elseif status == constant('App\\Entity\\Booking::STATUS_PENDING') %}
                                    <span class="badge bg-warning text-dark">En attente</span>
                                {% elseif status == constant('App\\Entity\\Booking::STATUS_REFUSED') %}
                                    <span class="badge bg-danger">Refusée</span>
                                {% else %}
                                    <span class="badge bg-secondary">Inconnu</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="d-flex gap-2 flex-wrap">
                                    {# ✅ Bouton "Voir" pour tout le monde #}
                                    <a href="{{ path('app_booking_show', {'id': booking.id}) }}" class="btn btn-sm btn-primary" title="Voir">
                                        <i class="bi bi-eye"></i> Voir
                                    </a>

                                    {# ✅ Actions pour le CONDUCTEUR uniquement #}
                                    {% if app.user == carpool.driver %}
                                        
                                        {# Accepter (si en attente) #}
                                        {% if status == constant('App\\Entity\\Booking::STATUS_PENDING') %}
                                            <form method="post" action="{{ path('app_booking_confirm', {'id': booking.id}) }}" style="display:inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('confirm' ~ booking.id) }}">
                                                <button type="submit" class="btn btn-sm btn-success" title="Accepter" onclick="return confirm('Confirmer cette réservation ?')">
                                                    <i class="bi bi-check-circle"></i> Accepter
                                                </button>
                                            </form>

                                            <form method="post" action="{{ path('app_booking_refuse', {'id': booking.id}) }}" style="display:inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('refuse' ~ booking.id) }}">
                                                <button type="submit" class="btn btn-sm btn-danger" title="Refuser" onclick="return confirm('Refuser cette réservation ?')">
                                                    <i class="bi bi-x-circle"></i> Refuser
                                                </button>
                                            </form>
                                        {% endif %}

                                        {# Annuler (si confirmée) #}
                                        {% if status == constant('App\\Entity\\Booking::STATUS_CONFIRMED') %}
                                            <form method="post" action="{{ path('app_booking_cancel', {'id': booking.id}) }}" style="display:inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ booking.id) }}">
                                                <button type="submit" class="btn btn-sm btn-warning" title="Annuler" onclick="return confirm('Annuler cette réservation ?')">
                                                    <i class="bi bi-exclamation-triangle"></i> Annuler
                                                </button>
                                            </form>
                                        {% endif %}

                                    {% endif %}

                                    {# ✅ Actions pour le PASSAGER uniquement #}
                                    {% if app.user == booking.passenger %}
                                        
                                        {# Modifier (si en attente ou confirmée) #}
                                        {% if status == constant('App\\Entity\\Booking::STATUS_PENDING') or status == constant('App\\Entity\\Booking::STATUS_CONFIRMED') %}
                                            <a href="{{ path('app_booking_edit', {'id': booking.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                                <i class="bi bi-pencil"></i> Modifier
                                            </a>
                                        {% endif %}

                                        {# Annuler (si en attente ou confirmée) #}
                                        {% if status == constant('App\\Entity\\Booking::STATUS_PENDING') or status == constant('App\\Entity\\Booking::STATUS_CONFIRMED') %}
                                            <form method="post" action="{{ path('app_booking_cancel', {'id': booking.id}) }}" style="display:inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ booking.id) }}">
                                                <button type="submit" class="btn btn-sm btn-danger" title="Annuler ma réservation" onclick="return confirm('Annuler votre réservation ?')">
                                                    <i class="bi bi-x-circle"></i> Annuler
                                                </button>
                                            </form>
                                        {% endif %}

                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Aucune réservation pour ce covoiturage.
        </div>
    {% endif %}

    {# ✅ Bouton pour réserver (si l'utilisateur n'est PAS le conducteur) #}
    {% if app.user != carpool.driver and carpool.availableSeats > 0 %}
        <div class="mt-4">
            <a href="{{ path('app_booking_new', {'carpool': carpool.id}) }}" class="btn btn-success btn-lg">
                <i class="bi bi-plus-circle"></i> Réserver ce covoiturage
            </a>
        </div>
    {% endif %}
{% endblock %}