{% extends 'base.html.twig' %}

{% block title %}Détail du covoiturage{% endblock %}

{% block body %}
    <h1 class="mb-4">Détail du covoiturage</h1>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr><th>Id</th><td>{{ carpool.id }}</td></tr>
                    <tr><th>Date départ</th><td>{{ carpool.departureDate ? carpool.departureDate|date('Y-m-d') : '' }}</td></tr>
                    <tr><th>Heure départ</th><td>{{ carpool.departureTime ? carpool.departureTime|date('H:i') : '' }}</td></tr>
                    <tr><th>Lieu départ</th><td>{{ carpool.departureLocation }}</td></tr>
                    <tr><th>Date arrivée</th><td>{{ carpool.arrivalDate ? carpool.arrivalDate|date('Y-m-d') : '' }}</td></tr>
                    <tr><th>Heure arrivée</th><td>{{ carpool.arrivalTime ? carpool.arrivalTime|date('H:i') : '' }}</td></tr>
                    <tr><th>Lieu arrivée</th><td>{{ carpool.arrivalLocation }}</td></tr>
                    <tr><th>Prix par place</th><td>{{ carpool.pricePerSeat }} crédits</td></tr>
                    <tr><th>Places disponibles</th><td>{{ carpool.availableSeats }}</td></tr>
                    <tr>
                        <th>Statut</th>
                        <td>
                            {% set status = carpool.status %}
                            {% if status == constant('App\\Entity\\Carpool::STATUS_ACTIVE') %}
                                <span class="badge bg-success">Actif</span>
                            {% elseif status == constant('App\\Entity\\Carpool::STATUS_COMPLETED') %}
                                <span class="badge bg-primary">Terminé</span>
                            {% elseif status == constant('App\\Entity\\Carpool::STATUS_CANCELLED') %}
                                <span class="badge bg-danger">Annulé</span>
                            {% elseif status == constant('App\\Entity\\Carpool::STATUS_ARCHIVED') %}
                                <span class="badge bg-secondary">Archivé</span>
                            {% else %}
                                <span class="badge bg-light text-dark">Inconnu</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Chauffeur</th>
                        <td>
                            {% if carpool.driver %}
                                <a href="{{ path('app_user_show', {'id': carpool.driver.id}) }}">
                                    {{ carpool.driver.firstName }} {{ carpool.driver.lastName }}
                                </a>
                            {% else %}
                                N/A
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Voiture</th>
                        <td>
                            {% if carpool.car %}
                                <a href="{{ path('app_car_show', {'id': carpool.car.id}) }}">
                                    {{ carpool.car.brand }} {{ carpool.car.model }} ({{ carpool.car.registration }})
                                </a>
                            {% else %}
                                N/A
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="mt-3 d-flex gap-2">
                <a href="{{ path('app_carpool_index') }}" class="btn btn-secondary">Retour à la liste</a>
                <a href="{{ path('app_carpool_edit', {'id': carpool.id}) }}" class="btn btn-warning">Modifier</a>
                {{ include('carpool/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}