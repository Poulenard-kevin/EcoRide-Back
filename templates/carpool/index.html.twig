{% extends 'base.html.twig' %}

{% block title %}Liste des covoiturages{% endblock %}

{% block body %}
    <h1 class="mb-4">Liste des covoiturages</h1>

    <a href="{{ path('app_carpool_new') }}" class="btn btn-primary mb-3">Créer un nouveau covoiturage</a>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover align-middle">
            <thead>
    <tr>
        <th>Id</th>
        <th>Départ</th>
        <th>Arrivée</th>
        <th>Prix / place</th>
        <th>Places dispo</th>
        <th>Statut</th>
        <th>Chauffeur</th>
        <th>Voiture</th>
        <th>Actions</th>
    </tr>
        </thead>
            <tbody>
                {% for carpool in carpools %}
                    <tr>
                        <td>{{ carpool.id }}</td>
                        <td>
                            {{ carpool.departureLocation }}
                            {{ carpool.departureDate ? carpool.departureDate|date('Y-m-d') : '' }}
                            {{ carpool.departureTime ? carpool.departureTime|date('H:i') : '' }}
                        </td>
                        <td>
                            {{ carpool.arrivalLocation }}   
                            {{ carpool.arrivalDate ? carpool.arrivalDate|date('Y-m-d') : '' }}
                            {{ carpool.arrivalTime ? carpool.arrivalTime|date('H:i') : '' }}
                        </td>
                        {% set price = carpool.pricePerSeat %}
                        {% set roundedPrice = (price // 5) * 5 %}
                        <td>{{ roundedPrice }} crédits</td>
                        <td>{{ carpool.availableSeats }}</td>
                        <td>
                            {% set status = carpool.status %}
                            {% if status == constant('App\\Entity\\Carpool::STATUS_ACTIVE') %}
                                <span class="badge bg-success">Actif</span>
                            {% elseif status == constant('App\\Entity\\Carpool::STATUS_COMPLETED') %}
                                <span class="badge bg-primary">Terminé</span>
                            {% elseif status == constant('App\\Entity\\Carpool::STATUS_CANCELLED') %}
                                <span class="badge bg-danger">Annulé</span>
                            {% elseif status == constant('App\\Entity\\Carpool::STATUS_ARCHIVED') %}
                                <span class="badge bg-secondary">Archivé</span>
                            {% else %}
                                <span class="badge bg-light text-dark">Inconnu</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if carpool.driver %}
                                <a href="{{ path('app_user_show', {'id': carpool.driver.id}) }}">
                                    {{ carpool.driver.firstName }} {{ carpool.driver.lastName }}
                                </a>
                            {% else %}
                                N/A
                            {% endif %}
                        </td>
                        <td>
                            {% if carpool.car %}
                                <a href="{{ path('app_car_show', {'id': carpool.car.id}) }}">
                                    {{ carpool.car.brand }} {{ carpool.car.model }} ({{ carpool.car.registration }})
                                </a>
                            {% else %}
                                N/A
                            {% endif %}
                        </td>
                        <td>
                            <div class="d-flex justify-content-center align-items-center gap-2">
                                <a href="{{ path('app_carpool_show', {'id': carpool.id}) }}" class="btn btn-sm btn-primary" title="Voir">
                                    <i class="bi bi-eye"></i> Voir
                                </a>
                                <a href="{{ path('app_carpool_edit', {'id': carpool.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                    <i class="bi bi-pencil"></i> Modifier
                                </a>
                                <form method="post" action="{{ path('app_carpool_delete', {'id': carpool.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer ce covoiturage ?');" style="margin: 0;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ carpool.id) }}">
                                    <button class="btn btn-sm btn-danger" title="Supprimer" type="submit">
                                        <i class="bi bi-trash"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" class="text-center fst-italic">Aucun covoiturage trouvé</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}